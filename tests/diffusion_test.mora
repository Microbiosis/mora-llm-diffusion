export task test_deadzone_gates_and_shadow_gradients()
  let base = load_diffusion_config("config/diffusion.json")
  let pc = base.plasticity
  let mid = 0.5 * (pc.eps_low + pc.eps_high)
  let m_low_mid = deadzone_low_gate(mid, pc)
  let m_fail_mid = deadzone_fail_gate(mid, pc)
  assert(m_low_mid < 0.02 and m_fail_mid < 0.02, "dead-zone midpoint must silence both growth and decay")
  assert(pc.lambda_b >= 5.0 * pc.eta_b, "homeostatic bias pullback must be 5x-10x faster than growth")

  let sc_cfg = ScheduleConfig(pretrain_steps = 10, pretrain_lr = 0.03, cold_start_steps = 1, consolidation_steps = 1, mature_eval_steps = 1, ood_adapt_steps = 1, seed = 42)
  let cfg = DiffusionAppConfig(architecture = base.architecture, external_expert = base.external_expert, model = base.model, plasticity = pc, schedule = sc_cfg)
  let sys = init_diffusion_system(cfg)

  let mc = cfg.model
  let pair = sample_structured_batch(2, mc.num_blocks, mc.block_size, mc.d_model, "complex", 77)
  let em1 = emerge_step(sys, pair[0], pair[1], 100)
  assert(mean_shortcut_v_rms(em1.system) > 0.0, "V must grow from zero on step 1 without gradient deadlock")
end

export task test_cold_start_no_premature_skip_and_fast_path()
  let base = load_diffusion_config("config/diffusion.json")
  let sc_cfg = ScheduleConfig(pretrain_steps = 10, pretrain_lr = 0.03, cold_start_steps = 1, consolidation_steps = 1, mature_eval_steps = 1, ood_adapt_steps = 1, seed = 99)
  let cfg = DiffusionAppConfig(architecture = base.architecture, external_expert = base.external_expert, model = base.model, plasticity = base.plasticity, schedule = sc_cfg)
  let sys = init_diffusion_system(cfg)

  let mc = cfg.model
  let pair = sample_structured_batch(2, mc.num_blocks, mc.block_size, mc.d_model, "simple", 123)
  let inf_fast = infer_system(sys, pair[0], false)
  assert_eq(inf_fast.path_mode, "external_fast")
  assert_eq(inf_fast.backbone_nfe, 0)
  assert_eq(inf_fast.shortcuts_used, 0)

  -- The DDIM sampler walks the schedule from infer_start_step down to level 1
  -- and the final read-out IS the level 1 -> 0 step, so the full path spends
  -- exactly infer_start_step backbone evaluations.
  -- It used to spend one MORE: the loop consumed level 1 and a second read-out
  -- call was then applied to the already denoised level-0 state, which both
  -- wasted an evaluation and told the backbone a wrong noise level (tau).
  let inf_full = infer_system(sys, pair[0], true)
  assert_eq(inf_full.backbone_nfe, base.model.infer_start_step)
  assert_eq(inf_full.shortcuts_used, 0)
end

export task test_cad_bebc_attention_hierarchy()
  let p_blk = build_block_projection(4, 2)
  let off_diag = build_off_diag_mask(4)
  let prefix_mask = build_prefix_causal_mask(4, 2, 2)
  let w_blk = init_w_blk(off_diag, 4.0)
  let b0 = struct_bias_from_wblk(w_blk, p_blk, off_diag, prefix_mask)

  assert(math.abs(float(b0[0][1])) < 0.000000000001, "intra-block attention bias must be 0.0")
  assert(float(b0[0][2]) < -100000000.0, "prefix causal future block must be masked")
  -- The inter-block bias must EQUAL W_blk (rather than a hard-coded number):
  -- the initial bias now sits strictly inside the clamp interval so that the
  -- error-gated backprop can grow the coupling, and the test states the
  -- structural property instead of a constant that changes with the config.
  let w_offdiag = w_blk.to_list()[0][1]
  assert(math.abs(float(b0[2][0]) - w_offdiag) < 0.000000000001, "prefix backward attention must follow W_blk")
  assert(math.abs(float(b0[4][6]) - w_offdiag) < 0.000000000001)
  assert(math.abs(float(b0[6][4]) - w_offdiag) < 0.000000000001)
  -- and the initial bias must be strictly inside the clamp interval, otherwise
  -- the coupling could never grow.
  assert(w_offdiag > -4.0, "initial W_blk must leave room for the coupling to grow")
end

export task test_live_http_external_expert_roundtrip()
  let base = load_diffusion_config("config/diffusion.json")
  let exp_local = load_external_expert(base.external_expert, base.model.rms_eps, "cpu")
  let router_srv = make_expert_router(exp_local)

  let listener = tcp_listen("127.0.0.1:0")
  let addr = listener.local_addr()
  let srv = spawn router_srv.serve_listener(listener, 2)

  let health_resp = get(addr, "/health")
  assert_eq(health_resp.status, 200)

  let http_cfg = ExternalExpertConfig(mode = "http", http_addr = addr, http_path = "/v1/predict", model_name = base.external_expert.model_name, timeout_ms = 5000, checkpoint_path = base.external_expert.checkpoint_path, llama_checkpoint_path = base.external_expert.llama_checkpoint_path)
  let exp_http = load_external_expert(http_cfg, base.model.rms_eps, "cpu")

  let mc = base.model
  let pair = sample_structured_batch(2, mc.num_blocks, mc.block_size, mc.d_model, "simple", 555)
  let y_http = expert_predict(exp_http, pair[0])
  let y_ref = expert_predict(exp_local, pair[0])

  let served = srv.join()
  listener.close()
  assert_eq(served, 2)
  assert((y_http - y_ref).abs().max() < 0.000000001, "HTTP external model prediction must match reference")
end

export task test_unified_cad_bebc_text_pipeline()
  let base = load_diffusion_config("config/diffusion.json")
  let sc_cfg = ScheduleConfig(pretrain_steps = 10, pretrain_lr = 0.03, cold_start_steps = 1, consolidation_steps = 1, mature_eval_steps = 1, ood_adapt_steps = 1, seed = 2026)
  let cfg = DiffusionAppConfig(architecture = base.architecture, external_expert = base.external_expert, model = base.model, plasticity = base.plasticity, schedule = sc_cfg)

  let codec = load_latent_codec("config/default.json", cfg.external_expert.llama_checkpoint_path)
  let sys = init_diffusion_system(cfg)
  assert(count_expert_parameters(sys.expert) == 25056, "frozen Mini-LLaMA external expert must load all 25,056 params")

  let gen = cad_bebc_generate_text(sys, codec, "The transformer ", 8, 0.0, 8, 42)
  assert(gen.text.len() > 0, "unified CAD-BEBC text pipeline must produce decoded text")
end

export task test_error_gated_emergence_skip_and_ood_fallback()
  let base = load_diffusion_config("config/diffusion.json")
  let fast_pc = PlasticityConfig(eps_low = 0.12, eps_high = 0.22, temp_e = 0.012, eps_shortcut = 0.16, temp_s = 0.015, eta_lr = 0.6, lambda_decay = 0.2, eta_g = 0.02, lambda_g = 0.1, eta_b = 0.35, lambda_b = 2.0, eta_conn = 0.5, lambda_conn = 2.5, eta_comp = 3.5, lambda_ext_bias = 0.001, align_weight = base.plasticity.align_weight, gate_sup_weight = base.plasticity.gate_sup_weight, gate_logit_space = base.plasticity.gate_logit_space, gate_margin = base.plasticity.gate_margin, comp_gate_weight = base.plasticity.comp_gate_weight, comp_adv_scale = base.plasticity.comp_adv_scale, lambda_comp = base.plasticity.lambda_comp)
  -- The maturity budget must cover the measured ramp of the skip gate.
  -- Measured: b_g rises ~0.55 per 8 consolidation steps from b_rest = -5.5, and the
  -- execution threshold is logit(theta_skip) = logit(0.62) = 0.49, so the gate
  -- needs ~90 steps to mature. 40 steps could never trigger a skip, which is why
  -- this test failed on "matured b_g must trigger early-skip execution".
  let fast_sc = ScheduleConfig(pretrain_steps = 100, pretrain_lr = 0.03, cold_start_steps = 2, consolidation_steps = 120, mature_eval_steps = 4, ood_adapt_steps = 15, seed = 20261123)
  let cfg = DiffusionAppConfig(architecture = base.architecture, external_expert = base.external_expert, model = base.model, plasticity = fast_pc, schedule = fast_sc)

  let sys = init_diffusion_system(cfg)
  let mc = cfg.model
  let init_coupling = mean_interblock_coupling(sys.w_blk, mc.init_iso)
  let c_probe = sample_structured_batch(2, mc.num_blocks, mc.block_size, mc.d_model, "complex", 777)

  let st = 1
  while st <= 120
    let pair = sample_structured_batch(2, mc.num_blocks, mc.block_size, mc.d_model, "complex", 3000 + st)
    let em = emerge_step(sys, pair[0], pair[1], 4000 + st)
    assign sys = em.system
    assign st = st + 1
  end

  assert(mean_shortcut_v_rms(sys) > 0.0005, "V must grow under low-error m_ok gating")
  assert(mean_interblock_coupling(sys.w_blk, mc.init_iso) > init_coupling, "W_blk cross-block coupling must grow via m_low-gated backprop")

  -- force_internal isolates the SKIP mechanism from the COMPETITION mechanism:
  -- on synthetic data the frozen external expert is the more accurate branch, so
  -- the competition gate legitimately routes to the external fast path. This
  -- test is about whether a matured b_g actually triggers the early skip, so the
  -- internal path is forced.
  let inf = infer_system(sys, c_probe[0], false, true)
  assert(inf.shortcuts_used >= 1, "matured b_g must trigger early-skip execution")
  let inf_full_ref = infer_system(sys, c_probe[0], true, true)
  assert(inf.backbone_nfe < inf_full_ref.backbone_nfe, "shortened inference must strictly reduce backbone NFE")
  -- Only the 2-level spans are shortcut-eligible (they are the spans the
  -- shortcut slots are trained on), so every skipped segment must save
  -- exactly two backbone evaluations.
  assert_eq(inf_full_ref.backbone_nfe - inf.backbone_nfe, 2 * inf.shortcuts_used)

  let b_before_ood = mean_gate_bias(sys)
  let v_before_ood = mean_shortcut_v_rms(sys)
  let j = 1
  while j <= 15
    let ood_p = sample_structured_batch(2, mc.num_blocks, mc.block_size, mc.d_model, "ood", 6000 + j)
    let em_ood = emerge_step(sys, ood_p[0], ood_p[1], 7000 + j)
    assign sys = em_ood.system
    assign j = j + 1
  end

  assert(mean_gate_bias(sys) < b_before_ood - 2.0, "m_fail must pull b_g back toward b_rest under OOD")
  assert(mean_shortcut_v_rms(sys) < v_before_ood * 0.5, "m_fail must decay shortcut weights V under OOD")
  let inf_post = infer_system(sys, c_probe[0], true)
  assert_eq(inf_post.shortcuts_used, 0)
  -- Full-path NFE under the DDIM sampler is exactly infer_start_step: the
  -- schedule is walked from infer_start_step down to level 1 and the read-out
  -- call performs the level 1 -> 0 step.
  assert_eq(inf_post.backbone_nfe, base.model.infer_start_step)
end
