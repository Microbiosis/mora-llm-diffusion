-- Unit tests for ByteTokenizer (`src/tokenizer.mora`).

import "src/tokenizer.mora"

export task test_tokenizer_roundtrip()
  let tok = create_tokenizer()
  assert_eq(tok.vocab_size, 101)
  let sample = "The transformer reads tokens!\n\tStep 42: loss = 1.25."
  let ids = tok.encode(sample, false, false)
  let decoded = tok.decode(ids)
  assert_eq(decoded, sample)
end

export task test_tokenizer_special_tokens()
  let tok = create_tokenizer()
  let ids = tok.encode("Hi", true, true)
  assert_eq(ids.len(), 4)
  assert_eq(ids[0], tok.bos_id)
  assert_eq(ids[3], tok.eos_id)
  assert_eq(tok.decode(ids), "Hi")
  assert_eq(tok.decode_token(tok.pad_id), "<pad>")
  assert_eq(tok.decode_token(tok.bos_id), "<bos>")
  assert_eq(tok.decode_token(tok.eos_id), "<eos>")
  assert_eq(tok.decode_token(tok.unk_id), "<unk>")
end

export task test_tokenizer_empty()
  let tok = create_tokenizer()
  let ids = tok.encode("", false, false)
  assert_eq(ids.len(), 0)
  assert_eq(tok.decode(ids), "")
end
