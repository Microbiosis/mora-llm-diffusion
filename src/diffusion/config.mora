-- Configuration structs and JSON loader for CAD-BEBC (Error-Gated Slow Weight Emergence).

export struct ExternalExpertConfig
  mode: string = "llama"
  http_addr: string = "127.0.0.1:18080"
  http_path: string = "/v1/predict"
  model_name: string = "mini-llama-frozen-v1"
  timeout_ms: int = 3000
  checkpoint_path: string = "models/external_expert.safetensors"
  llama_checkpoint_path: string = "models/mini_llama_frozen.safetensors"
end

export struct DiffModelConfig
  architecture: string = "cad-bebc-unified-v2"
  n_layers: int = 2
  num_blocks: int = 4
  block_size: int = 4
  prefix_blocks: int = 2
  d_model: int = 32
  n_heads: int = 4
  head_dim: int = 8
  ffn_hidden: int = 64
  rms_eps: float = 0.00001
  num_steps: int = 8
  shortcut_rank: int = 8
  init_iso: float = 2.0
  b_rest: float = -5.5
  b_max: float = 3.0
  init_comp_bias: float = -4.0
  theta_skip: float = 0.62
  shortcut_u_init: float = 0.5
  shortcut_v_init: float = 0.01
  -- VP noise schedule (linear betas) and DDIM sampler controls.
  beta_start: float = 0.05
  beta_end: float = 0.5
  -- When true the backbone consumes [z_t ; x_obs] (input projection width 2D) so the
  -- observation enters as an explicit condition and the forward process can stay
  -- a standard variance-preserving process.
  cond_inject: bool = true
  -- DDIM stochasticity; 0 = deterministic sampler.
  ddim_eta: float = 0.0
  -- Schedule step the conditional DDIM sampler starts from. The observation is
  -- projected onto the VP trajectory at this noise level, then the sampler runs
  -- down to t = 0. Larger = more noise added = more freedom to deviate from the
  -- observation, at the cost of more NFE and a less faithful repair.
  infer_start_step: int = 8
end

export struct PlasticityConfig
  eps_low: float = 0.11
  eps_high: float = 0.23
  temp_e: float = 0.015
  eps_shortcut: float = 0.14
  temp_s: float = 0.015
  eta_lr: float = 0.5
  lambda_decay: float = 0.15
  eta_g: float = 0.02
  lambda_g: float = 0.08
  eta_b: float = 0.08
  lambda_b: float = 0.6
  eta_conn: float = 0.5
  lambda_conn: float = 2.5
  eta_comp: float = 0.6
  lambda_ext_bias: float = 0.001
  align_weight: float = 0.25
  gate_sup_weight: float = 0.03
  gate_logit_space: float = 1.0
  gate_margin: float = 1.0
  comp_gate_weight: float = 0.5
  comp_adv_scale: float = 4.0
  lambda_comp: float = 0.05
end

export struct ScheduleConfig
  pretrain_steps: int = 140
  pretrain_lr: float = 0.03
  cold_start_steps: int = 15
  consolidation_steps: int = 260
  mature_eval_steps: int = 30
  ood_adapt_steps: int = 60
  seed: int = 20261123
end

export struct DiffusionAppConfig
  architecture: string = "cad-bebc-unified-v2"
  external_expert: ExternalExpertConfig
  model: DiffModelConfig
  plasticity: PlasticityConfig
  schedule: ScheduleConfig
end

task dcfg_dict(d: dict<string, any>, key: string): dict<string, any>
  let v = d.get(key)
  if type_of(v) != "dict" then
    return {}
  end
  let parsed: dict<string, any> = json.parse(json.stringify(v))
  return parsed
end

task dcfg_str(d: dict<string, any>, key: string, fallback: string): string
  let v = d.get(key)
  if type_of(v) != "string" then
    return fallback
  end
  return str(v)
end

task dcfg_int(d: dict<string, any>, key: string, fallback: int): int
  let v = d.get(key)
  if type_of(v) == "int" or type_of(v) == "float" then
    return int(str(v))
  end
  return fallback
end

task dcfg_float(d: dict<string, any>, key: string, fallback: float): float
  let v = d.get(key)
  if type_of(v) == "float" or type_of(v) == "int" then
    return float(str(v))
  end
  return fallback
end

task dcfg_bool(d: dict<string, any>, key: string, fallback: bool): bool
  let v = d.get(key)
  if type_of(v) == "bool" then
    if str(v) == "true" then
      return true
    end
    return false
  end
  return fallback
end

export task load_diffusion_config(path: string = "config/diffusion.json"): DiffusionAppConfig
  let raw = file.read_text(path)
  let root: dict<string, any> = json.parse(raw)
  let arch = dcfg_str(root, "architecture", "cad-bebc-unified-v2")
  let e = dcfg_dict(root, "external_expert")
  let m = dcfg_dict(root, "model")
  let p = dcfg_dict(root, "plasticity")
  let s = dcfg_dict(root, "schedule")

  let ec = ExternalExpertConfig(mode = dcfg_str(e, "mode", "llama"), http_addr = dcfg_str(e, "http_addr", "127.0.0.1:18080"), http_path = dcfg_str(e, "http_path", "/v1/predict"), model_name = dcfg_str(e, "model_name", "mini-llama-frozen-v1"), timeout_ms = dcfg_int(e, "timeout_ms", 3000), checkpoint_path = dcfg_str(e, "checkpoint_path", "models/external_expert.safetensors"), llama_checkpoint_path = dcfg_str(e, "llama_checkpoint_path", "models/mini_llama_frozen.safetensors"))
  let mc = DiffModelConfig(architecture = arch, n_layers = dcfg_int(m, "n_layers", 2), num_blocks = dcfg_int(m, "num_blocks", 4), block_size = dcfg_int(m, "block_size", 4), prefix_blocks = dcfg_int(m, "prefix_blocks", 2), d_model = dcfg_int(m, "d_model", 32), n_heads = dcfg_int(m, "n_heads", 4), head_dim = dcfg_int(m, "head_dim", 8), ffn_hidden = dcfg_int(m, "ffn_hidden", 64), rms_eps = dcfg_float(m, "rms_eps", 0.00001), num_steps = dcfg_int(m, "num_steps", 8), shortcut_rank = dcfg_int(m, "shortcut_rank", 8), init_iso = dcfg_float(m, "init_iso", 2.0), b_rest = dcfg_float(m, "b_rest", -5.5), b_max = dcfg_float(m, "b_max", 3.0), init_comp_bias = dcfg_float(m, "init_comp_bias", -4.0), theta_skip = dcfg_float(m, "theta_skip", 0.62), shortcut_u_init = dcfg_float(m, "shortcut_u_init", 0.5), shortcut_v_init = dcfg_float(m, "shortcut_v_init", 0.01), beta_start = dcfg_float(m, "beta_start", 0.05), beta_end = dcfg_float(m, "beta_end", 0.5), cond_inject = dcfg_bool(m, "cond_inject", true), ddim_eta = dcfg_float(m, "ddim_eta", 0.0), infer_start_step = dcfg_int(m, "infer_start_step", 8))
  let pc = PlasticityConfig(eps_low = dcfg_float(p, "eps_low", 0.11), eps_high = dcfg_float(p, "eps_high", 0.23), temp_e = dcfg_float(p, "temp_e", 0.015), eps_shortcut = dcfg_float(p, "eps_shortcut", 0.14), temp_s = dcfg_float(p, "temp_s", 0.015), eta_lr = dcfg_float(p, "eta_lr", 0.5), lambda_decay = dcfg_float(p, "lambda_decay", 0.15), eta_g = dcfg_float(p, "eta_g", 0.02), lambda_g = dcfg_float(p, "lambda_g", 0.08), eta_b = dcfg_float(p, "eta_b", 0.08), lambda_b = dcfg_float(p, "lambda_b", 0.6), eta_conn = dcfg_float(p, "eta_conn", 0.5), lambda_conn = dcfg_float(p, "lambda_conn", 2.5), eta_comp = dcfg_float(p, "eta_comp", 0.6), lambda_ext_bias = dcfg_float(p, "lambda_ext_bias", 0.001), align_weight = dcfg_float(p, "align_weight", 0.25), gate_sup_weight = dcfg_float(p, "gate_sup_weight", 0.03), gate_logit_space = dcfg_float(p, "gate_logit_space", 1.0), gate_margin = dcfg_float(p, "gate_margin", 1.0), comp_gate_weight = dcfg_float(p, "comp_gate_weight", 0.5), comp_adv_scale = dcfg_float(p, "comp_adv_scale", 4.0), lambda_comp = dcfg_float(p, "lambda_comp", 0.05))
  let sc = ScheduleConfig(pretrain_steps = dcfg_int(s, "pretrain_steps", 140), pretrain_lr = dcfg_float(s, "pretrain_lr", 0.03), cold_start_steps = dcfg_int(s, "cold_start_steps", 15), consolidation_steps = dcfg_int(s, "consolidation_steps", 260), mature_eval_steps = dcfg_int(s, "mature_eval_steps", 30), ood_adapt_steps = dcfg_int(s, "ood_adapt_steps", 60), seed = dcfg_int(s, "seed", 20261123))

  return DiffusionAppConfig(architecture = arch, external_expert = ec, model = mc, plasticity = pc, schedule = sc)
end
