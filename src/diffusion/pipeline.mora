-- Unified CAD-BEBC Pipeline:
-- Fully Differentiable Parameter Learning (all weights via backprop, gated by m_ok / m_fail).

import "std/net/http"
import "std/nn/safetensors"
import "src/config.mora"
import "src/tokenizer.mora"
import "src/data.mora"
import "src/model.mora"
import "src/checkpoint.mora"
import "src/sampler.mora"
import "src/latent_codec.mora"
import "src/diffusion/config.mora"
import "src/diffusion/causal_graph.mora"
import "src/diffusion/backbone.mora"
import "src/diffusion/shortcut.mora"
import "src/diffusion/expert.mora"

export struct InternalizedDiffusionSystem
  cfg: DiffusionAppConfig
  sched: VpSchedule
  backbone: BackboneParams
  w_blk: Tensor<f64, _, cpu>
  p_blk: Tensor<f64, _, cpu>
  off_diag: Tensor<f64, _, cpu>
  prefix_mask: Tensor<f64, _, cpu>
  u_all: Tensor<f64, _, cpu>
  v_all: Tensor<f64, _, cpu>
  wg_all: Tensor<f64, _, cpu>
  bg_all: Tensor<f64, _, cpu>
  w_comp: Tensor<f64, _, cpu>
  b_comp: Tensor<f64, _, cpu>
  expert: ExternalFastExpert
  total_steps: int = 0
end

export struct EmergeStepResult
  system: InternalizedDiffusionSystem
  int_loss: float = 0.0
  e_base: float = 0.0
  m_ok_mean: float = 0.0
  m_fail: float = 0.0
end

export struct TextGenResult
  text: string = ""
  path_mode: string = "internal_shortened"
  backbone_nfe: int = 8
  shortcuts_used: int = 0
end

export struct InferResult
  output: Tensor<f64, _, cpu>
  path_mode: string = "internal_short"
  backbone_nfe: int = 8
  shortcuts_used: int = 0
  pi_int: float = 0.0
  g_int: float = 0.0
end

-- pretrain_steps = 0 skips the backbone pretraining entirely, which is what the
-- real-corpus training entrypoint uses: it pretrains the backbone on real corpus
-- windows first and passes the result in via backbone_override.
export task init_diffusion_system(cfg: DiffusionAppConfig, backbone_override: BackboneParams = BackboneParams(in_proj = Tensor::zeros([1, 1], "f64", "cpu"), cond_proj = Tensor::zeros([1, 1], "f64", "cpu"), pos_emb = Tensor::zeros([1, 1, 1], "f64", "cpu"), time_proj = Tensor::zeros([1, 1], "f64", "cpu"), attn_norm = Tensor::zeros([1, 1], "f64", "cpu"), wq = Tensor::zeros([1, 1, 1], "f64", "cpu"), wk = Tensor::zeros([1, 1, 1], "f64", "cpu"), wv = Tensor::zeros([1, 1, 1], "f64", "cpu"), wo = Tensor::zeros([1, 1, 1], "f64", "cpu"), ffn_norm = Tensor::zeros([1, 1], "f64", "cpu"), w_gate = Tensor::zeros([1, 1, 1], "f64", "cpu"), w_up = Tensor::zeros([1, 1, 1], "f64", "cpu"), w_down = Tensor::zeros([1, 1, 1], "f64", "cpu"), out_norm = Tensor::zeros([1], "f64", "cpu"), out_proj = Tensor::zeros([1, 1], "f64", "cpu"))): InternalizedDiffusionSystem
  let mc = cfg.model
  let sc = cfg.schedule
  random.seed(sc.seed)

  let p_blk = build_block_projection(mc.num_blocks, mc.block_size)
  let off_diag = build_off_diag_mask(mc.num_blocks)
  let prefix_mask = build_prefix_causal_mask(mc.num_blocks, mc.block_size, mc.prefix_blocks)
  let w_blk = init_w_blk(off_diag, mc.init_iso)
  let init_bias = struct_bias_from_wblk(w_blk, p_blk, off_diag, prefix_mask)

  -- VP noise schedule shared by the backbone training and the DDIM sampler.
  let sched = make_vp_schedule(mc.num_steps, mc.beta_start, mc.beta_end)
  let bp0 = init_backbone_params(mc, sc.seed)
  let bp = if sc.pretrain_steps > 0 then pretrain_backbone(bp0, mc, sched, init_bias, sc.pretrain_steps, sc.pretrain_lr, sc.seed) else backbone_override end

  -- Cross-step low-rank shortcut (U, V).
  -- U/V form a bilinear product in shortcut_apply: z + silu(z @ U) @ V^T.
  -- With V initialised to exactly zero, d(loss)/dU == 0 (measured: |g_u| = 0.0),
  -- so U could never learn and V only moved through the tiny |U| = 0.01 factor.
  -- V is now initialised with small random noise (still an identity-scale cold start,
  -- since V enters as a multiplicative residual) which unblocks the gradient.
  let u_all = Tensor::randn([3, mc.d_model, mc.shortcut_rank], "f64", "cpu") * mc.shortcut_u_init
  let v_all = Tensor::randn([3, mc.d_model, mc.shortcut_rank], "f64", "cpu") * mc.shortcut_v_init
  let wg_all = Tensor::zeros([3, mc.d_model], "f64", "cpu")
  let bg_all = Tensor::full([3], mc.b_rest, "f64", "cpu")

  let w_comp = Tensor::zeros([mc.d_model], "f64", "cpu")
  let b_comp = Tensor::full([1], mc.init_comp_bias, "f64", "cpu")

  let exp = load_external_expert(cfg.external_expert, mc.rms_eps, "cpu")

  return InternalizedDiffusionSystem(cfg = cfg, sched = sched, backbone = bp, w_blk = w_blk, p_blk = p_blk, off_diag = off_diag, prefix_mask = prefix_mask, u_all = u_all, v_all = v_all, wg_all = wg_all, bg_all = bg_all, w_comp = w_comp, b_comp = b_comp, expert = exp, total_steps = 0)
end

-- Differentiable DDIM step (the backbone forward stays on the autograd tape).
task ode_step_tracked(bp: BackboneParams, z: Tensor<f64, _, cpu>, step_t: int, cond: Tensor<f64, _, cpu>, sched: VpSchedule, bias: Tensor<f64, _, cpu>, mc: DiffModelConfig): Tensor<f64, _, cpu>
  let t_index = step_t - 1
  let s_index = step_t - 2
  let tau_t = Tensor::full([1, 1], vp_tau(sched, t_index), "f64", "cpu")
  let x0h = backbone_forward_raw(bp.in_proj, bp.pos_emb, bp.time_proj, bp.attn_norm, bp.wq, bp.wk, bp.wv, bp.wo, bp.ffn_norm, bp.w_gate, bp.w_up, bp.w_down, bp.out_norm, bp.out_proj, z, tau_t, cond, bp.cond_proj, bias, mc.n_layers, mc.n_heads, mc.head_dim, mc.rms_eps)
  return ddim_step(sched, t_index, s_index, z, x0h, mc.ddim_eta)
end

export task unified_diff_loss(p_wblk: Tensor<f64, _, cpu>, p_u: Tensor<f64, _, cpu>, p_v: Tensor<f64, _, cpu>, p_wg: Tensor<f64, _, cpu>, p_bg: Tensor<f64, _, cpu>, p_wcomp: Tensor<f64, _, cpu>, p_bcomp: Tensor<f64, _, cpu>, bp: BackboneParams, x_obs: Tensor<f64, _, cpu>, x_0: Tensor<f64, _, cpu>, y_ext: Tensor<f64, _, cpu>, seg_entries: list<Tensor<f64, _, cpu>>, seg_targets: list<Tensor<f64, _, cpu>>, z_pre_final: Tensor<f64, _, cpu>, p_blk: Tensor<f64, _, cpu>, off_diag: Tensor<f64, _, cpu>, prefix_mask: Tensor<f64, _, cpu>, sched: VpSchedule, mc: DiffModelConfig, pc: PlasticityConfig): Tensor<f64, _, cpu>
  let bias = struct_bias_from_wblk(p_wblk, p_blk, off_diag, prefix_mask)
  -- The condition tensor keeps the same shape as z_t; mc.cond_inject decides
  -- whether the backbone concatenates it.
  let cond = x_obs
  let y_int = ode_step_tracked(bp, z_pre_final, 1, cond, sched, bias, mc)
  let pi_int = ((x_obs.rms_norm(mc.rms_eps) * p_wcomp).mean() + p_bcomp).sigmoid()
  let y_mix = y_int * pi_int + y_ext * (1.0 - pi_int)
  let d_mix = y_mix - x_0
  let d_int = y_int - x_0
  -- Reconstruction term.
  -- NOTE: the recon term is O(1)-O(10) while the shortcut alignment term is O(0.01);
  -- with the original fixed weight 0.25 the alignment gradient was ~3 orders of
  -- magnitude smaller than the reconstruction gradient, so the shortcut could not
  -- learn anything. align_weight is now an explicit, configurable multiplier.
  -- IMPORTANT: the reconstruction term is kept as a TENSOR (not a float).
  -- Mora's autograd seeds the root gradient only for tensor outputs
  -- (src/runtime/autograd.rs: `grads[out_idx] = Some(vec![1.0])`); when the
  -- differentiated function returns a plain float the engine takes the
  -- `zero_grads_for_leaves` path and every leaf gradient becomes zero.
  -- Mixing pi_int in keeps the expression a tensor and preserves the autograd
  -- edge into pi_int -> p_wcomp / p_bcomp.
  let recon = (d_mix * d_mix).mean() + 0.5 * (d_int * d_int).mean() + pi_int * 0.0

  -- Competition gate: error-driven advantage, not an unconditional prior.
  -- The original term (lambda_ext_bias * pi_int.sum()) pushed pi_int DOWN at every
  -- step regardless of which branch was actually better. Measured on the shipped
  -- config: internal path MSE 0.2895 vs external expert MSE 0.3615, i.e. the
  -- internal path WAS better, yet g_bcomp was negative (-0.0057) and pi_int decayed
  -- monotonically, permanently pinning the system on the external fast path.
  -- Instead we score the two branches by their own error and let the gate move
  -- towards the better one:
  --   advantage = e_ext - e_int  (>0 means internal is more accurate)
  -- and penalise only pi_int when the internal branch is actually worse.
  -- Take the branch-comparison scalars inside a `no_grad` block: inside a
  -- differentiable context Tensor.mean() returns a TENSOR (src/value/tensor.rs
  -- records a TapeOp::Mean node), while outside it returns a plain float. The
  -- no_grad block gives a stable scalar in both cases. The advantage only selects
  -- which penalty coefficient to apply, so it does not itself need a gradient.
  --
  -- ARCHITECTURE FIX (input symmetry): the two branches must be compared on the
  -- SAME input, otherwise "which branch is better" is meaningless. The internal
  -- path here starts from z_pre_final (an intermediate ODE state), while the
  -- external expert consumes the raw observation x_obs; comparing them directly
  -- measured advantage < 0 on every real-corpus window even though the internal
  -- path was clearly better when both start from x_obs (MSE 0.106 vs 0.183).
  -- So the internal branch is additionally evaluated from x_obs, matching the
  -- inference semantics in infer_system.
  let y_int_obs = no_grad
    backbone_ode_step(bp, mc, x_obs, mc.num_steps, cond, sched, bias)
  end
  let e_int = no_grad
    ((y_int_obs - x_0) * (y_int_obs - x_0)).mean()
  end
  let e_ext = no_grad
    ((y_ext - x_0) * (y_ext - x_0)).mean()
  end
  let advantage = e_ext - e_int
  -- Keep the term DIFFERENTIABLE in pi_int.
  -- (d_mix * d_mix).mean() yields a scalar, so the penalty is kept as a tensor and
  -- folded into the final loss as a tensor; float(...) at the very end converts the
  -- accumulated 1-element tensor to the scalar return value while keeping the
  -- autograd edge into pi_int -> p_wcomp / p_bcomp.
  -- Competition gate: error-driven advantage, not an unconditional prior.
  --
  -- The mixed-reconstruction term alone CANNOT drive the competition: with
  --   y_mix = y_int*pi + y_ext*(1-pi)
  -- its gradient wrt pi is 2*d_mix*(y_int - y_ext), which points AWAY from the
  -- internal branch whenever mixing already reduces the error (measured
  -- g_bcomp = -0.0057 even though the internal path was clearly better:
  -- MSE 0.2895 vs 0.3615). So the gate needs an explicit, sign-correct driver.
  --
  -- We therefore add a differentiable ADVANTAGE term on the gate logit:
  --   d(pi)/d(logit) = pi*(1-pi)
  -- and the desired logit shift is proportional to (e_ext - e_int), i.e. the gate
  -- moves towards the internal branch exactly when the internal branch is more
  -- accurate, and towards the external branch when it is not.
  -- Competition gate: supervised directly towards the more accurate branch.
  --
  -- Why not rely on the mixed-reconstruction gradient: with
  --   y_mix = y_int*pi + y_ext*(1-pi)
  -- its gradient wrt pi is 2*d_mix*(y_int - y_ext), which points AWAY from the
  -- internal branch whenever mixing already lowers the error (measured
  -- g_bcomp = -0.0057 even though the internal path was clearly better:
  -- MSE 0.2895 vs 0.3615). The gate therefore needs its own objective.
  --
  -- We supervise the gate LOGIT towards the target probability of the better
  -- branch, with the target derived from the measured error advantage:
  --   target_pi = sigmoid(adv_logit_scale * advantage)   (internal if advantage>0)
  -- and minimise (logit - logit(target_pi))^2. The logit-space form keeps the
  -- gradient usable even when the gate is deeply saturated (pi_int ~ 0.018).
  let pi_logit = ((x_obs.rms_norm(mc.rms_eps) * p_wcomp).mean() + p_bcomp)
  -- The target is derived from the SIGN of the advantage, not its magnitude.
  -- Using the raw magnitude made the target logit flip sign between windows (the
  -- advantage is small and noisy on real corpus data), so the gate oscillated
  -- around its initial value instead of moving. The sign is the robust signal:
  -- "internal branch is more accurate" vs "external branch is more accurate".
  let adv_sign = if advantage > 0.0 then 1.0 else -1.0 end
  let adv_scaled = pc.comp_adv_scale * adv_sign
  -- sigmoid on the scalar advantage (computed directly to avoid a tensor round-trip)
  let target_pi = 1.0 / (1.0 + math.exp(-adv_scaled))
  let target_logit = math.log(target_pi / (1.0 - target_pi) + 0.000000001)
  let comp_sup = (pi_logit - target_logit) * (pi_logit - target_logit) * pc.comp_gate_weight
  let recon = recon + comp_sup

  let align = 0.0
  let gate_sup = 0.0
  let k = 0
  while k < 3
    let pred = shortcut_apply(seg_entries[k], p_u[k], p_v[k], mc.rms_eps)
    let d = pred - seg_targets[k]
    let e_align = (d * d).mean()
    assign align = align + e_align

    -- Differentiable gate supervision.
    -- Supervise the gate PRE-ACTIVATION logit instead of the sigmoid output:
    -- with b_rest = -5.5 the sigmoid is saturated (g ~ 0.004), so d(g)/d(logit)
    -- ~ 0.004 and the gate gradient was ~250x weaker than the logit gradient.
    -- Supervising the logit keeps the gradient usable across the whole maturity ramp.
    let z_bar = pool_mean_feature(seg_entries[k], mc.rms_eps)
    let logit = (z_bar * p_wg[k]).mean() + p_bg[k]
    let g = logit.sigmoid()
    let margin = pc.eps_shortcut * 1.8
    let raw_t = (margin - e_align) / (pc.temp_s * 2.0)
    let target = raw_t.sigmoid()
    -- Extra positive bias when alignment is already decent
    let bonus = if e_align < pc.eps_shortcut then 0.35 else 0.0 end
    let soft_target = target * (1.0 - bonus) + bonus
    let ge = if pc.gate_logit_space > 0.5 then
      -- Supervise the PRE-ACTIVATION logit.
      -- The gate only needs to clear the execution threshold (theta_skip), it does not
      -- need to saturate to probability 1.0. Driving the target logit to the
      -- threshold margin (logit(theta_skip) + gate_margin) instead of
      -- logit(0.999) ~ +7 keeps the maturity ramp reachable from b_rest = -5.5.
      let th_logit = math.log(mc.theta_skip / (1.0 - mc.theta_skip) + 0.000000001)
      let tl = th_logit + pc.gate_margin
      let ge_l = logit - tl
      ge_l
    else
      let ge_p = g - soft_target
      ge_p
    end
    assign gate_sup = gate_sup + (ge * ge).mean() * pc.gate_sup_weight
    assign k = k + 1
  end
  -- NOTE: the loss is returned as a 1-element TENSOR on purpose.
  -- Mora's autograd seeds the root gradient only for tensor outputs
  -- (src/runtime/autograd.rs: `grads[out_idx] = Some(vec![1.0])`); a float return
  -- yields zero gradients for every leaf. Keeping the tensor form preserves the
  -- autograd edge into pi_int -> p_wcomp / p_bcomp.
  return recon + pc.align_weight * align + gate_sup
end

task clamp_wblk(w: Tensor<f64, _, cpu>, off_diag: Tensor<f64, _, cpu>, init_iso: float): Tensor<f64, _, cpu>
  let rows: list<any> = w.to_list()
  let mask_rows: list<any> = off_diag.to_list()
  let k = rows.len()
  let out_rows: list<list<float>> = []
  let i = 0
  while i < k
    let row: list<any> = rows[i]
    let mrow: list<any> = mask_rows[i]
    let out_r: list<float> = []
    let j = 0
    while j < k
      if float(mrow[j]) < 0.5 then
        assign out_r = out_r.push(0.0)
      else
        let v = float(row[j])
        if v < -init_iso then
          assign v = -init_iso
        end
        if v > 0.0 then
          assign v = 0.0
        end
        assign out_r = out_r.push(v)
      end
      assign j = j + 1
    end
    assign out_rows = out_rows.push(out_r)
    assign i = i + 1
  end
  return Tensor::from_list(out_rows, "f64")
end

export task emerge_step(sys: InternalizedDiffusionSystem, x_obs: Tensor<f64, _, cpu>, x_0: Tensor<f64, _, cpu>, seed: int): EmergeStepResult
  let mc = sys.cfg.model
  let pc = sys.cfg.plasticity
  let bias = struct_bias_from_wblk(sys.w_blk, sys.p_blk, sys.off_diag, sys.prefix_mask)
  let cond = x_obs

  let y_ext = expert_predict(sys.expert, x_obs)

  -- DDIM trajectory start: the forward-noised x_0 at the noisiest schedule step,
  -- matching what the DDIM sampler visits during inference. The observation
  -- enters only as the CONDITION, never as part of the state.
  random.seed(seed + 11)
  let eps_init = Tensor::randn(x_0.shape(), "f64", "cpu")
  let z = no_grad
  ddim_init(sys.sched, x_0, eps_init)
end

let seg_entries: list<Tensor<f64, _, cpu>> = []
let seg_targets: list<Tensor<f64, _, cpu>> = []
let seg = 0
let t_cur = mc.num_steps
while seg < 3
  let z_entry = z
  let z1 = no_grad
  backbone_ode_step(sys.backbone, mc, z, t_cur, cond, sys.sched, bias)
end
let z2 = no_grad
backbone_ode_step(sys.backbone, mc, z1, t_cur - 1, cond, sys.sched, bias)
end
assign seg_entries = seg_entries.push(z_entry)
assign seg_targets = seg_targets.push(z2)
assign z = z2
assign t_cur = t_cur - 2
assign seg = seg + 1
end
let z_pre_final = z
let y_int = no_grad
backbone_ode_step(sys.backbone, mc, z_pre_final, 1, cond, sys.sched, bias)
end

let e_base = compute_consistency_error(sys.backbone, mc, x_obs, y_int, cond, bias, seed + 19)
let m_low = deadzone_low_gate(e_base, pc)
let m_fail = deadzone_fail_gate(e_base, pc)

-- Fully differentiable update: single value_and_grad over all plasticity parameters
let vg = value_and_grad(unified_diff_loss, argnums = [0, 1, 2, 3, 4, 5, 6])
let res = vg(sys.w_blk, sys.u_all, sys.v_all, sys.wg_all, sys.bg_all, sys.w_comp, sys.b_comp, sys.backbone, x_obs, x_0, y_ext, seg_entries, seg_targets, z_pre_final, sys.p_blk, sys.off_diag, sys.prefix_mask, sys.sched, mc, pc)
-- unified_diff_loss returns a 1-element tensor (required for Mora's autograd to
-- seed the root gradient), so the reported loss is read out of the tensor.
let int_loss = res[0].to_list()[0]
let gs: list<Tensor<f64, _, cpu>> = res[1]

let g_wblk = gs[0]
let g_u = gs[1]
let g_v = gs[2]
let g_wg = gs[3]
let g_bg = gs[4]
let g_wcomp = gs[5]
let g_bcomp = gs[6]

-- Apply gated step sizes (slow growth / faster fallback)
let step_ok = m_low
let step_fail = m_fail

let w_iso = sys.off_diag * (-mc.init_iso)
let w_blk_raw = sys.w_blk - g_wblk * (pc.eta_conn * step_ok) - (sys.w_blk - w_iso) * (pc.lambda_conn * step_fail)
let w_blk_next = clamp_wblk(w_blk_raw, sys.off_diag, mc.init_iso)

let u_next = sys.u_all * (1.0 - pc.lambda_decay * step_fail) - g_u * (pc.eta_lr * step_ok)
let v_next = sys.v_all * (1.0 - pc.lambda_decay * step_fail) - g_v * (pc.eta_lr * step_ok)

let wg_next = sys.wg_all * (1.0 - pc.lambda_g * step_fail) - g_wg * (pc.eta_g * step_ok)
let bg_raw = sys.bg_all - g_bg * (pc.eta_b * step_ok) - (sys.bg_all - mc.b_rest) * (pc.lambda_b * step_fail)
let bg_list: list<float> = []
let bi = 0
while bi < 3
  let bv = float(bg_raw[bi])
  if bv < mc.b_rest then
    assign bv = mc.b_rest
  end
  if bv > mc.b_max then
    assign bv = mc.b_max
  end
  assign bg_list = bg_list.push(bv)
  assign bi = bi + 1
end
let bg_next = Tensor::from_list(bg_list, "f64")

let w_comp_next = sys.w_comp * (1.0 - pc.lambda_g * step_fail) - g_wcomp * (pc.eta_comp * step_ok)
-- The competition gate gets its own learning rate and pullback rate:
-- reusing lambda_b (designed for the skip-gate bias, where pullback must be 5-10x
-- faster than growth) here suppressed the competition gate on real corpus data
-- (b_comp oscillated around -3.5 instead of rising). It is also read via to_list()
-- because Tensor.item() yields a TENSOR in a differentiable context, which
-- float() rejects.
let b_comp_cur = sys.b_comp.to_list()[0]
let b_comp_val = b_comp_cur - g_bcomp.to_list()[0] * (pc.eta_comp * step_ok) - pc.lambda_comp * step_fail * (b_comp_cur - mc.init_comp_bias)
let b_comp_next = Tensor::full([1], b_comp_val, "f64", "cpu")

let next_sys = InternalizedDiffusionSystem(cfg = sys.cfg, sched = sys.sched, backbone = sys.backbone, w_blk = w_blk_next, p_blk = sys.p_blk, off_diag = sys.off_diag, prefix_mask = sys.prefix_mask, u_all = u_next, v_all = v_next, wg_all = wg_next, bg_all = bg_next, w_comp = w_comp_next, b_comp = b_comp_next, expert = sys.expert, total_steps = sys.total_steps + 1)
return EmergeStepResult(system = next_sys, int_loss = int_loss, e_base = e_base, m_ok_mean = step_ok, m_fail = step_fail)
end

export task comp_gate_scalar(sys: InternalizedDiffusionSystem, x_obs: Tensor<f64, _, cpu>): float
  -- NOTE: in a differentiable context Tensor.item() yields a TENSOR (which float()
  -- rejects), so the bias is read via to_list() -> [scalar].
  let logit = no_grad
    float((x_obs.rms_norm(sys.cfg.model.rms_eps) * sys.w_comp).mean()) + sys.b_comp.to_list()[0]
  end
  return sigmoid_scalar(logit)
end

-- force_full     : run the backbone on every step (no early skip)
-- force_internal : ignore the external fast path, so the INTERNAL path can be
--                  exercised even when the competition gate currently prefers the
--                  external expert. This isolates the skip mechanism from the
--                  competition mechanism, which are independent claims.
export task infer_system(sys: InternalizedDiffusionSystem, x_obs: Tensor<f64, _, cpu>, force_full: bool = false, force_internal: bool = false): InferResult
  let mc = sys.cfg.model
  let pi_int = comp_gate_scalar(sys, x_obs)
  let y_ext = expert_predict(sys.expert, x_obs)

  if !force_full and !force_internal and pi_int < 0.05 then
    return InferResult(output = y_ext, path_mode = "external_fast", backbone_nfe = 0, shortcuts_used = 0, pi_int = pi_int, g_int = 0.0)
  end

  let bias = struct_bias_from_wblk(sys.w_blk, sys.p_blk, sys.off_diag, sys.prefix_mask)
  let cond = x_obs

  -- Conditional (img2img-style) DDIM start.
  --
  -- The task is "repair this observation", not "sample from pure noise", so the
  -- sampler must START from the observation rather than from an unknown x_0.
  -- The observation is projected onto the VP trajectory at schedule step
  -- infer_start_step:
  --     z_{t0} = sqrt(ab_{t0}) * x_obs + sqrt(1 - ab_{t0}) * eps
  -- and the DDIM updates then run along the VP manifold down to t = 0. This keeps
  -- the state ON the training manifold (the failure mode of the previous update
  -- rule) while preserving the repair semantics.
  let t_start = mc.infer_start_step
  if t_start < 1 then
    assign t_start = 1
  end
  if t_start > mc.num_steps then
    assign t_start = mc.num_steps
  end
  random.seed(12345)
  let eps_start = Tensor::randn(x_obs.shape(), "f64", "cpu")
  let z = no_grad
  let ab_t0 = vp_alpha_bar(sys.sched, t_start - 1)
  x_obs * math.sqrt(ab_t0) + eps_start * math.sqrt(1.0 - ab_t0)
end
-- DDIM sampling loop.
--
-- The previous loop advanced a counter by 2 per segment and indexed the
-- schedule with it (4,3 / 2,1 / 0,-1). Under the DDIM schedule that last pair
-- indexes step -1, whose sqrt argument is negative, so the full path produced
-- NaN. The loop is rewritten here to walk the schedule exactly once, from
-- t_start down to 1, in single DDIM steps.
--
-- The cross-step shortcut is still consulted every SEGMENT_STRIDE schedule
-- steps: when the matured gate fires, the DDIM update for that segment is
-- REPLACED by the learned shortcut, which is what realises the "skip 2 backbone
-- steps" claim. The skipped steps are still counted as NFE savings.
let used_sc = 0
let g_prod = 1.0
let seg = 0
let nfe = 0
let t_cur = t_start

while t_cur >= 1
  let seg_idx = seg % 3
  -- NOTE: Tensor.item()/float() do not accept tensors; read the scalar bias via
  -- to_list() (the gate bias tensor is 1-D, so to_list()[i] is the float).
  let bg_seg = sys.bg_all.to_list()[seg_idx]
  let gk = shortcut_gate_scalar(z, sys.wg_all[seg_idx], bg_seg, mc.rms_eps)
  assign g_prod = g_prod * gk
  -- how many schedule steps this segment covers
  let seg_steps = if t_cur >= 3 then 2 else 1 end
  let skip = !force_full and gk >= mc.theta_skip
  if skip then
    -- Replace the segment's DDIM updates with the learned cross-step shortcut.
    -- The backbone is NOT evaluated for this segment, so it costs no NFE: that is
    -- the whole point of the internalized shortcut.
    assign z = no_grad
    shortcut_apply(z, sys.u_all[seg_idx], sys.v_all[seg_idx], mc.rms_eps)
    end
    assign used_sc = used_sc + 1
    assign t_cur = t_cur - seg_steps
  else
    -- z1 must be declared OUTSIDE the no_grad block: a `let` inside the block is
    -- local to it, and referencing it after the block made the compiler treat the
    -- unresolved binding as a non-builtin method target.
    let z1 = no_grad
      backbone_ode_step(sys.backbone, mc, z, t_cur, cond, sys.sched, bias)
    end
    assign z = z1
    assign nfe = nfe + 1
    if seg_steps > 1 then
      let z2 = no_grad
        backbone_ode_step(sys.backbone, mc, z1, t_cur - 1, cond, sys.sched, bias)
      end
      assign z = z2
      assign nfe = nfe + 1
    end
    assign t_cur = t_cur - seg_steps
  end
  assign seg = seg + 1
end

-- The final DDIM step down to t = 0.
let y_int = no_grad
  backbone_ode_step(sys.backbone, mc, z, 1, cond, sys.sched, bias)
end
assign nfe = nfe + 1

let g_mean = g_prod ** (1.0 / 3.0)
let y_out = y_int * pi_int + y_ext * (1.0 - pi_int)
let mode_str = if used_sc > 0 then "internal_shortened" else "internal_full" end
return InferResult(output = y_out, path_mode = mode_str, backbone_nfe = nfe, shortcuts_used = used_sc, pi_int = pi_int, g_int = g_mean)
end

export task cad_bebc_generate_text(sys: InternalizedDiffusionSystem, codec: LatentCodec, prompt: string, prefix_len: int = 8, temperature: float = 0.0, top_k: int = 8, seed: int = 42): TextGenResult
  let enc = encode_prefix_with_masked_suffix(codec, prompt, prefix_len, 0.2, seed)
  let res = infer_system(sys, enc.z_in, false)
  let text_out = decode_next_tokens_via_lm_head(codec, res.output, temperature, top_k)
  return TextGenResult(text = text_out, path_mode = res.path_mode, backbone_nfe = res.backbone_nfe, shortcuts_used = res.shortcuts_used)
end

export task mean_gate_bias(sys: InternalizedDiffusionSystem): float
  return float(sys.bg_all.mean())
end

export task mean_shortcut_v_rms(sys: InternalizedDiffusionSystem): float
  return math.sqrt(float((sys.v_all * sys.v_all).mean()))
end
